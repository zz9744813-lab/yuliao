# 网关（OpenAI 兼容中转）
LG_GATEWAY_BASE_URL=http://your-gateway/v1
LG_GATEWAY_API_KEY=sk-xxx

# real | mock（mock 不联网，全流程假数据跑通用）
LG_LLM_MODE=real

# 默认 SQLite；有 PG 时用：
# LG_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/language_genome

# 模型集（默认已对准 `…/models` 列出的可用项）
# LG_RECON_MODELS=deepseek/deepseek-v4.1-flash,glm-5.3,meta/muse-spark-1.3-contributor,moonshotai/kimi-k3
# LG_STRONG_MODEL=moonshotai/kimi-k3
# LG_EXTRACTOR_MODELS=moonshotai/kimi-k3,deepseek/deepseek-v4.1-flash

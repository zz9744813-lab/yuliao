# 网关（OpenAI 兼容中转）
LG_GATEWAY_BASE_URL=http://your-gateway/v1
LG_GATEWAY_API_KEY=sk-xxx

# real | mock（mock 不联网，全流程假数据跑通用）
LG_LLM_MODE=real

# 默认 SQLite；有 PG 时用：
# LG_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/language_genome

# 模型集（默认已对准 `…/models` 列出的可用项；名字对不对用 `python scripts/preflight_models.py <名>` 验）
# 注意：带 `deepseek/` 前缀的旧 id 已下线（503 model_not_found），池里在册的是裸名。
# LG_LLM_MODEL=deepseek-v4.1-flash
# LG_RECON_MODELS=deepseek-v4.1-flash,z-ai/glm-5.3,moonshotai/kimi-k3,agnes-3.0-flash
# LG_STRONG_MODEL=moonshotai/kimi-k3
# LG_EXTRACTOR_MODELS=moonshotai/kimi-k3,deepseek-v4.1-flash
